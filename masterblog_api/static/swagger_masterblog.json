{
    "swagger": "2.0",
    "info": {
        "title": "Masterblog API",
        "version": "1.0.0",
        "description": "JSON API for managing blog posts."
    },
    "basePath": "/",
    "schemes": [
        "http"
    ],
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "tags": [
        {
            "name": "Posts",
            "description": "Create, read, update, delete, search, and like blog posts."
        }
    ],
    "paths": {
        "/api/posts": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "List blog posts",
                "description": "Returns posts, optionally sorted, in pages. Unknown parameters (including the search parameters) and invalid values return 400.",
                "parameters": [
                    {
                        "$ref": "#/parameters/Page"
                    },
                    {
                        "$ref": "#/parameters/PerPage"
                    },
                    {
                        "$ref": "#/parameters/Sort"
                    },
                    {
                        "$ref": "#/parameters/Direction"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of posts.",
                        "schema": {
                            "$ref": "#/definitions/PaginatedPosts"
                        }
                    },
                    "400": {
                        "$ref": "#/responses/BadRequest"
                    }
                }
            },
            "post": {
                "tags": [
                    "Posts"
                ],
                "summary": "Create a blog post",
                "parameters": [
                    {
                        "in": "body",
                        "name": "post",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/NewPost"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "The created post.",
                        "schema": {
                            "$ref": "#/definitions/Post"
                        }
                    },
                    "400": {
                        "$ref": "#/responses/InvalidRequest"
                    }
                }
            }
        },
        "/api/posts/{id}": {
            "parameters": [
                {
                    "$ref": "#/parameters/PostId"
                }
            ],
            "delete": {
                "tags": [
                    "Posts"
                ],
                "summary": "Delete a blog post",
                "responses": {
                    "200": {
                        "description": "The post was deleted.",
                        "schema": {
                            "$ref": "#/definitions/Message"
                        }
                    },
                    "400": {
                        "$ref": "#/responses/InvalidPostId"
                    },
                    "404": {
                        "$ref": "#/responses/PostNotFound"
                    }
                }
            },
            "put": {
                "tags": [
                    "Posts"
                ],
                "summary": "Update a blog post",
                "description": "Updates title and/or content. Empty values and all other fields are ignored. A body without a usable title or content changes nothing and returns the post's current values.",
                "parameters": [
                    {
                        "in": "body",
                        "name": "post",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/UpdatePost"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The updated post.",
                        "schema": {
                            "$ref": "#/definitions/UpdatedPost"
                        }
                    },
                    "400": {
                        "$ref": "#/responses/InvalidRequest"
                    },
                    "404": {
                        "$ref": "#/responses/PostNotFound"
                    }
                }
            }
        },
        "/api/posts/{id}/like": {
            "parameters": [
                {
                    "$ref": "#/parameters/PostId"
                }
            ],
            "post": {
                "tags": [
                    "Posts"
                ],
                "summary": "Toggle the current user's like",
                "responses": {
                    "200": {
                        "description": "The updated like state.",
                        "schema": {
                            "$ref": "#/definitions/LikeResult"
                        }
                    },
                    "404": {
                        "$ref": "#/responses/PostNotFound"
                    }
                }
            }
        },
        "/api/posts/search": {
            "get": {
                "tags": [
                    "Posts"
                ],
                "summary": "Search blog posts",
                "description": "Case-insensitive substring search in title and/or content. At least one of title or content is required. Results can be sorted and are paginated like the post list. Unknown parameters and invalid values return 400.",
                "parameters": [
                    {
                        "$ref": "#/parameters/TitleQuery"
                    },
                    {
                        "$ref": "#/parameters/ContentQuery"
                    },
                    {
                        "$ref": "#/parameters/MatchEither"
                    },
                    {
                        "$ref": "#/parameters/Sort"
                    },
                    {
                        "$ref": "#/parameters/Direction"
                    },
                    {
                        "$ref": "#/parameters/Page"
                    },
                    {
                        "$ref": "#/parameters/PerPage"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sorted and paginated search results.",
                        "schema": {
                            "$ref": "#/definitions/PaginatedPosts"
                        }
                    },
                    "400": {
                        "description": "A query parameter is unknown or has an invalid value, or neither title nor content was given.",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                }
            }
        }
    },
    "parameters": {
        "PostId": {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32",
            "minimum": 1
        },
        "Page": {
            "name": "page",
            "in": "query",
            "description": "Page number (whole number, at least 1).",
            "type": "integer",
            "format": "int32",
            "default": 1,
            "minimum": 1
        },
        "PerPage": {
            "name": "per_page",
            "in": "query",
            "description": "Posts per page (whole number, at least 1, at most the configured maximum).",
            "type": "integer",
            "format": "int32",
            "default": 10,
            "minimum": 100
        },
        "Sort": {
            "name": "sort",
            "in": "query",
            "description": "Field to sort by. Without it, posts are returned in storage order. Ties are broken by id.",
            "type": "string",
            "enum": [
                "id",
                "title",
                "content"
            ]
        },
        "Direction": {
            "name": "direction",
            "in": "query",
            "description": "Sort direction (default: asc). Only used together with sort, otherwise ignored.",
            "type": "string",
            "enum": [
                "asc",
                "desc"
            ]
        },
        "TitleQuery": {
            "name": "title",
            "in": "query",
            "description": "Text to search for in the title (case-insensitive). Must not be blank.",
            "type": "string",
            "minLength": 1
        },
        "ContentQuery": {
            "name": "content",
            "in": "query",
            "description": "Text to search for in the content (case-insensitive). Must not be blank.",
            "type": "string",
            "minLength": 1
        },
        "MatchEither": {
            "name": "match_either",
            "in": "query",
            "description": "true: title or content must match. false: both must match. Only relevant if both title and content are given.",
            "type": "boolean",
            "default": false
        }
    },
    "responses": {
        "BadRequest": {
            "description": "A query parameter is unknown or has an invalid value. The message names the parameter.",
            "schema": {
                "$ref": "#/definitions/Error"
            },
            "examples": {
                "application/json": {
                    "error": "Invalid value for 'direction'. Allowed: asc, desc"
                }
            }
        },
        "InvalidRequest": {
            "description": "The request body is invalid.",
            "schema": {
                "$ref": "#/definitions/Error"
            }
        },
        "InvalidPostId": {
            "description": "The post ID is invalid.",
            "schema": {
                "$ref": "#/definitions/Error"
            }
        },
        "PostNotFound": {
            "description": "The post was not found.",
            "schema": {
                "$ref": "#/definitions/Error"
            }
        }
    },
    "definitions": {
        "Post": {
            "type": "object",
            "required": [
                "id",
                "author",
                "title",
                "content"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "format": "int32"
                },
                "author": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "liked_by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "NewPost": {
            "type": "object",
            "required": [
                "author",
                "title",
                "content"
            ],
            "properties": {
                "author": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                }
            }
        },
        "UpdatePost": {
            "type": "object",
            "minProperties": 1,
            "properties": {
                "title": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                }
            }
        },
        "UpdatedPost": {
            "type": "object",
            "required": [
                "id",
                "title",
                "content"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "format": "int32"
                },
                "title": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                }
            }
        },
        "PaginatedPosts": {
            "type": "object",
            "required": [
                "posts",
                "page",
                "per_page",
                "total",
                "total_pages"
            ],
            "properties": {
                "posts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Post"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "per_page": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                },
                "total_pages": {
                    "type": "integer"
                }
            }
        },
        "LikeResult": {
            "type": "object",
            "required": [
                "id",
                "liked",
                "like_count"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "format": "int32"
                },
                "liked": {
                    "type": "boolean"
                },
                "like_count": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "Message": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "Error": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}